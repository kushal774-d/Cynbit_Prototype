# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cynbit_leads

# Long random string used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=5000
NODE_ENV=development

# Only used by `npm run create-admin` to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
